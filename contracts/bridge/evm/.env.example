# Copy to contracts/bridge/evm/.env (gitignored). Foundry auto-loads `.env`
# from the project root, so `forge test` picks these up. Every variable here
# is an RPC endpoint or a public address: no forge command in this project
# signs, so this file never holds a key. NEVER commit the real .env.

# Sepolia fork suites (FactoryFork, LifiTestnetRailFork); public Sepolia RPC is fine.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# The live Aztec Registry FactoryFork binds a factory against; it skips itself when this is unset.
AZTEC_REGISTRY=0xa0bfb1b494fb49041e5c6e8c2c1be09cd171c6ba

# Optional — a fork suite skips itself when an endpoint it needs is unset.
# ETH_RPC_URL=https://...
# BASE_RPC_URL=https://...
# BASE_SEPOLIA_RPC_URL=https://...
