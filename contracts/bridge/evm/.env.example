# Copy to contracts/bridge/evm/.env (gitignored). Foundry auto-loads `.env`
# from the project root, so `forge script` / `forge test --fork-url` pick these
# up. NEVER commit the real .env.

# ─── L1 deploys (Sepolia) ─────────────────────────────────────────────
# EVM deployer private key (0x + 64 hex): the account PLAN_PINNED_L1_SIGNERS.testnet names in
# packages/bridge-core/scripts/live-intent.ts.
PRIVATE_KEY=0x...

# Public Sepolia RPC is fine (no key needed for these reads/sends).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional — only for `forge verify-contract` on Etherscan.
ETHERSCAN_API_KEY=

# ─── Live L1 addresses (from research/recon-testnet.md — testnet) ─────
# Canonical Aztec contracts the portal/router wire into.
REGISTRY_ADDRESS=0xa0bfb1b494fb49041e5c6e8c2c1be09cd171c6ba
# The live Aztec Registry the fork suites bind a factory against — FactoryFork and
# SwapBridgeRouterPermit2Fork skip themselves when this is unset.
AZTEC_REGISTRY=0xa0bfb1b494fb49041e5c6e8c2c1be09cd171c6ba
FEE_JUICE_ADDRESS=0x762c132040fda6183066fa3b14d985ee55aa3c18
FEE_JUICE_PORTAL=0x5Bb7523A95c1FDF1D2A3DD9fb7d497E7F5142D7F
FEE_ASSET_HANDLER=0x5602c39a6e9c5ace589f64f754927bcda4f4bfc9
