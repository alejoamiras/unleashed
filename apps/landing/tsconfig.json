{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["node", "vite/client"]
	},
	"include": ["*.ts", "scripts/**/*.ts", "src/**/*.ts", "tests/server/**/*.ts"]
}
