# Keyed-run template for the faucet's `deploy:testnet`: the testnet L2 deployer, paid through the SponsoredFPC.
# `env-exec request --template apps/tools/testnet-faucet.env.example -- …`
DEPLOYER_SECRET_KEY=op://Keyed-Runs/Unleashed-Testnet/DEPLOYER_SECRET_KEY
DEPLOYER_SALT=op://Keyed-Runs/Unleashed-Testnet/DEPLOYER_SALT
# The owner's shared dRPC CLI key: the deploy composes the node URL from it and never prints it.
DRPC_API_KEY=op://Keyed-Runs/dRPC-CLI/DRPC_API_KEY
