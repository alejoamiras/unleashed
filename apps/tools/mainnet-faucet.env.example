# Keyed-run template for the faucet's `deploy:mainnet`: the mainnet Drip deployer pays its own fees from Fee Juice
# the funding key deposits on L1. `env-exec request --template apps/tools/mainnet-faucet.env.example -- …`
# The owner creates Keyed-Runs/Unleashed-Mainnet-Drip by hand: a fresh deployer pair and a fresh funding key, both
# used for nothing else. FUNDING_PRIVATE_KEY must derive MAINNET_DRIP_FUNDER (deployer-funding.ts); the run refuses
# any other key, and its balance is the budget.
DEPLOYER_SECRET_KEY=op://Keyed-Runs/Unleashed-Mainnet-Drip/DEPLOYER_SECRET_KEY
DEPLOYER_SALT=op://Keyed-Runs/Unleashed-Mainnet-Drip/DEPLOYER_SALT
FUNDING_PRIVATE_KEY=op://Keyed-Runs/Unleashed-Mainnet-Drip/FUNDING_PRIVATE_KEY
# Broadcasts the fundings and scans the portal's logs from its first block.
ETH_RPC_URL=op://Keyed-Runs/Unleashed-Mainnet/ETH_RPC_URL
# The owner's shared dRPC CLI key: the deploy composes the node URL from it and never prints it.
DRPC_API_KEY=op://Keyed-Runs/dRPC-CLI/DRPC_API_KEY
