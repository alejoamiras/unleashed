{
	"name": "@unleashed/tools",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"build:testnet": "vite build --config vite.testnet.config.mts",
		"build:mainnet": "vite build --config vite.mainnet.config.mts",
		"build:local": "vite build --config vite.local.config.mts",
		"build:test-wallet": "vite build --config tests/browser/test-wallet/vite.config.mts",
		"preview:test-wallet": "vite preview --config tests/browser/test-wallet/vite.config.mts",
		"dev:local": "vite --config vite.local.config.mts",
		"preview": "vite preview",
		"typecheck": "vue-tsc --noEmit && tsc --noEmit -p tests/browser/tsconfig.json",
		"test": "bun --bun vitest run",
		"test:watch": "vitest",
		"test:e2e": "bun --bun vitest run --config vitest.e2e.config.ts",
		"test:browser": "bash scripts/e2e/agent.sh",
		"deploy:testnet": "bun run scripts/deploy.ts --network testnet",
		"deploy:testnet:dry": "bun run scripts/deploy.ts --network testnet --dry-run",
		"verify:deployments": "bun run scripts/verify-deployments.ts",
		"verify:build-target": "bun run scripts/verify-build-target.ts",
		"worker:deploy:testnet": "wrangler deploy -c wrangler.testnet.jsonc",
		"worker:deploy:mainnet": "wrangler deploy -c wrangler.mainnet.jsonc",
		"worker:preview": "bun scripts/upload-preview.ts"
	},
	"dependencies": {
		"@aztec-foundation/aztec-standards": "6.0.0-rc.1",
		"@aztec-foundation/bb.js": "6.0.0-rc.1",
		"@aztec-foundation/l1-artifacts": "6.0.0-rc.1",
		"@aztec-foundation/noir-acvm_js": "6.0.0-rc.1",
		"@aztec-foundation/noir-noirc_abi": "6.0.0-rc.1",
		"@aztec-labs/accounts": "6.0.0-rc.1",
		"@aztec-labs/aztec.js": "6.0.0-rc.1",
		"@aztec-labs/constants": "6.0.0-rc.1",
		"@aztec-labs/ethereum": "6.0.0-rc.1",
		"@aztec-labs/foundation": "6.0.0-rc.1",
		"@aztec-labs/noir-contracts.js": "6.0.0-rc.1",
		"@aztec-labs/protocol-contracts": "6.0.0-rc.1",
		"@aztec-labs/pxe": "6.0.0-rc.1",
		"@aztec-labs/standard-contracts": "6.0.0-rc.1",
		"@aztec-labs/stdlib": "6.0.0-rc.1",
		"@aztec-labs/wallet-sdk": "6.0.0-rc.1",
		"@aztec-labs/wallets": "6.0.0-rc.1",
		"@unleashed/bridge-core": "workspace:*",
		"@unleashed/design": "workspace:*",
		"@nulo-sh/resolve-asset": "0.1.0",
		"@nulo-sh/wallet-crypto": "0.1.0",
		"@nulo-sh/wallet-sdk-schema-patch": "0.1.0",
		"viem": "^2.52.2",
		"vue": "^3.5.38",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "^24.13.2",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vue/compiler-sfc": "^3.5.38",
		"@vue/test-utils": "^2.4.11",
		"jsdom": "^29.1.1",
		"typescript": "^6.0.3",
		"unplugin-vue-components": "^32.1.0",
		"vite": "^8.0.16",
		"vite-plugin-node-polyfills": "^0.28.0",
		"vitest": "^4.1.9",
		"vue-tsc": "^3.3.5",
		"wrangler": "4.129.1"
	}
}
