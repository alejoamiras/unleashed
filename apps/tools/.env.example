# Copy this to .env.local (gitignored) and fill in real values.
# .env.local is loaded by bun for both the dev server (VITE_* keys) and
# the faucet deploy script (DEPLOYER_*, AZTEC_NODE_URL keys).
#
# The BRIDGE generation (factory + router + hub) is NOT deployed from here:
# packages/bridge-core/.env + scripts/deploy-generation.ts own it, and the
# result lands in public/testnet-bridge.json via live-intent promote.

# ─── Faucet deploy only (scripts/deploy.ts; never sent to the browser) ─────

# Option A — hex Fr pair (recommended if you already have a funded
# testnet account, e.g. shared with another project on this machine):
DEPLOYER_SECRET_KEY=0x...   # 0x + 64 hex chars; Fr field element
DEPLOYER_SALT=0x...         # 0x + 64 hex chars; Fr field element

# Option B — utf8 string (derives a fresh account; only useful for a
# brand-new deploy you control end-to-end):
# DEPLOYER_SECRET=at-least-32-character-passphrase

# Override the default per-network RPC if you need to point at a fork.
# The default for --network testnet is https://lb.drpc.live/aztec-testnet/Ak_eT5HA2kbyqamqGTF702daoH37vEsR8YYxjmVXwXgc.
# AZTEC_NODE_URL=https://your-own-rpc

# ─── Frontend (Vite-prefixed; safe to ship in the browser bundle) ─────────

# DEV / e2e only — a production build ignores it and uses the target's node
# URL (src/lib/network-targets.ts), so a stale hosting variable cannot
# repoint a shipped build.
VITE_AZTEC_NODE_URL=https://lb.drpc.live/aztec-testnet/Ak_eT5HA2kbyqamqGTF702daoH37vEsR8YYxjmVXwXgc

# L2 explorer base for tx/address links (the L1 explorer comes from the target).
VITE_EXPLORER_BASE_URL=https://testnet.aztecscan.xyz

# Chain identity (L1 chainId + rollup version) and the bridge manifest are
# BUILD-TIME facts: the per-target vite config injects them
# (VITE_BRIDGE_MANIFEST_JSON via `define`, from public/<target>-bridge.json)
# and src/lib/chain-constants.ts holds the numbers. There is deliberately NO
# VITE_CHAIN_* override — a stale value here once broke the wallet handshake
# in prod ("No network configured for chainId …"). Change the constant in
# code, redeploy the generation, never env.

# Where the "Get a wallet" CTA points when no wallet is detected.
# VITE_WALLET_INSTALL_URL=https://chromewebstore.google.com/detail/...
