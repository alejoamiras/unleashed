# Keyed-run template for creating the two Workers by hand, before Workers Builds is connected.
# The value lives in 1Password only: `env-exec request --template apps/tools/cloudflare.env.example -- …`.
# Token scope: Account › Workers Scripts › Edit and Account › Account Settings › Read on this one
# account, no zone permission, a TTL of hours, IP-filtered to the host that runs it.
# op: import
CLOUDFLARE_API_TOKEN=op://Keyed-Runs/Cloudflare-Workers/CLOUDFLARE_API_TOKEN
