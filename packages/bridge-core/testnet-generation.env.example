# Keyed-run template for `deploy:generation` on testnet: the L1 signer plus the L2 deployer secret.
# `env-exec request --template packages/bridge-core/testnet-generation.env.example -- …`
# BRIDGE_DEPLOYER_SECRET_TESTNET must be the same value on every re-run: a crashed run resumes
# control of the deployer account only by re-deriving it.
PRIVATE_KEY=op://Keyed-Runs/Unleashed-Testnet/PRIVATE_KEY
SEPOLIA_RPC_URL=op://Keyed-Runs/Unleashed-Testnet/SEPOLIA_RPC_URL
BRIDGE_DEPLOYER_SECRET_TESTNET=op://Keyed-Runs/Unleashed-Testnet/BRIDGE_DEPLOYER_SECRET_TESTNET
# The owner's shared dRPC CLI key: the scripts compose the node URL from it and never print it.
DRPC_API_KEY=op://Keyed-Runs/dRPC-CLI/DRPC_API_KEY
