# Keyed-run template for the testnet L1 signer: live-intent build/verify/promote, the candidate
# smokes, fuel-testnet and the canaries. `env-exec request --template packages/bridge-core/testnet-l1.env.example -- …`
# PRIVATE_KEY must derive PLAN_PINNED_L1_SIGNERS.testnet (live-intent refuses any other signer).
# The item is created from testnet-provision.env.example.
PRIVATE_KEY=op://Keyed-Runs/Unleashed-Testnet/PRIVATE_KEY
SEPOLIA_RPC_URL=op://Keyed-Runs/Unleashed-Testnet/SEPOLIA_RPC_URL
