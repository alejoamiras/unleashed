# Keyed-run template for the testnet L1 signer: live-intent build, the candidate smokes, fuel-testnet
# and the fee-juice canary. Each signing run chains `live-intent verify` ahead of it in one `bash -c`;
# a run that signs nothing uses testnet-rpc.env.example instead.
# `env-exec request --template packages/bridge-core/testnet-l1.env.example -- …`
# PRIVATE_KEY must derive PLAN_PINNED_L1_SIGNERS.testnet (live-intent refuses any other signer).
# The item is created from testnet-provision.env.example.
PRIVATE_KEY=op://Keyed-Runs/Unleashed-Testnet/PRIVATE_KEY
SEPOLIA_RPC_URL=op://Keyed-Runs/Unleashed-Testnet/SEPOLIA_RPC_URL
# The owner's shared dRPC CLI key: the scripts compose the node URL from it and never print it.
DRPC_API_KEY=op://Keyed-Runs/dRPC-CLI/DRPC_API_KEY
