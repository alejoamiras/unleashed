# Keyed-run template for read-only testnet L1 checks, such as `verify-l1.ts --strict`:
# `env-exec request --template packages/bridge-core/testnet-rpc.env.example -- …`
# It carries no signer, so a check that only reads Sepolia never holds the deployer's key.
SEPOLIA_RPC_URL=op://Keyed-Runs/Unleashed-Testnet/SEPOLIA_RPC_URL
