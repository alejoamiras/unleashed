// Workers Builds, root directory = packages/testnet-relayer (Workers Builds reads this file there, and its
// Worker name must equal `name`):
//   build                   cd ../.. && bun install --frozen-lockfile --filter @unleashed/testnet-relayer
//   deploy (main)           bun run worker:deploy
//   non-production builds   off: the Worker has no preview to serve
//   variables               BUN_VERSION=1.4.2, NODE_VERSION=24, SKIP_DEPENDENCY_INSTALL=1
// The secret RELAYER_PRIVATE_KEY is set in the dashboard and never here. The Worker answers nothing over
// HTTP: no route, no workers.dev URL, only its cron trigger (wrangler-config.test.ts).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "unleashed-testnet-relayer",
	"main": "src/worker.ts",
	"compatibility_date": "2026-08-01",
	"workers_dev": false,
	"preview_urls": false,
	"triggers": { "crons": ["* * * * *"] },
	"observability": { "enabled": true },
	// Public keyless endpoints; a keyed provider's URL would go in a dashboard secret, never here.
	"vars": {
		"BASE_SEPOLIA_RPC_URL": "https://base-sepolia-rpc.publicnode.com",
		"SEPOLIA_RPC_URL": "https://ethereum-sepolia-rpc.publicnode.com"
	}
}
