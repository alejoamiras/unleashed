{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": false,
		"declarationMap": false,
		"types": []
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}
